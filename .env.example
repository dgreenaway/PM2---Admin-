NODE_ENV=production
PORT=3000

# Minimum 32-character random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Optional: supply a pre-hashed bcrypt password instead of plaintext
# Generate with: node -e "const b=require('bcryptjs'); b.hash('yourpass',12).then(console.log)"
# ADMIN_PASSWORD_HASH=$2a$12$...

# PM2 binary path (use pm2.cmd on Windows)
PM2_BIN=pm2

# Socket.IO update interval in milliseconds (default 5000)
UPDATE_INTERVAL_MS=5000
